<mxfile host="app.diagrams.net"><diagram id="bsc-backend" name="BSC backend flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="BSC AI Sales Rep: current backend (LangGraph workflow, as implemented)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="grp_spec" value="Specialists (app/specialists/*)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fontStyle=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1150" y="40" width="210" height="310" as="geometry"/></mxCell><mxCell id="user" value="Frontend / user query&lt;br&gt;POST /api/chat&lt;br&gt;{message, conversation_id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="140" height="60" as="geometry"/></mxCell><mxCell id="api" value="FastAPI route&lt;br&gt;api/routes/chat.py&lt;br&gt;HTTP + validation only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="100" width="140" height="60" as="geometry"/></mxCell><mxCell id="svc" value="Chat Service&lt;br&gt;handle_chat()&lt;br&gt;timeout + error envelope" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="140" height="60" as="geometry"/></mxCell><mxCell id="sl" value="session_loader&lt;br&gt;history, prev product IDs, pending clarification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="150" height="60" as="geometry"/></mxCell><mxCell id="qu" value="query_understanding (LLM)&lt;br&gt;intent, scope, entities, filters, context&lt;br&gt;resolves pending clarification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="95" width="170" height="70" as="geometry"/></mxCell><mxCell id="suff" value="sufficiency&lt;br&gt;(Python rules)&lt;br&gt;pending answered = always OK" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="950" y="80" width="170" height="100" as="geometry"/></mxCell><mxCell id="oos" value="out_of_scope&lt;br&gt;polite decline + 1-2 suggested prompts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="280" width="170" height="60" as="geometry"/></mxCell><mxCell id="clar" value="clarification (LLM)&lt;br&gt;ONE question, saved as pending_clarification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="280" width="170" height="60" as="geometry"/></mxCell><mxCell id="rec" value="specialist_recommendation&lt;br&gt;vector search, SQL truth, filters, top 5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1165" y="65" width="180" height="56" as="geometry"/></mxCell><mxCell id="cmp" value="specialist_comparison&lt;br&gt;resolve 2+ products by name" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1165" y="135" width="180" height="56" as="geometry"/></mxCell><mxCell id="kno" value="specialist_knowledge&lt;br&gt;blog-chunk search" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1165" y="205" width="180" height="56" as="geometry"/></mxCell><mxCell id="sup" value="specialist_support&lt;br&gt;FAQ/policy search, no live order data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1165" y="275" width="180" height="56" as="geometry"/></mxCell><mxCell id="comp" value="composer (LLM)&lt;br&gt;Markdown only; tray built in Python&lt;br&gt;empty = fixed reply, error = fallback" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1400" y="140" width="150" height="80" as="geometry"/></mxCell><mxCell id="val" value="validator&lt;br&gt;deterministic, no LLM&lt;br&gt;tray = specialist data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1600" y="140" width="140" height="70" as="geometry"/></mxCell><mxCell id="fb" value="fallback&lt;br&gt;fixed safe reply" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1600" y="290" width="140" height="50" as="geometry"/></mxCell><mxCell id="fin" value="finalize&lt;br&gt;save turn: history, shown product IDs, pending" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1400" y="420" width="150" height="60" as="geometry"/></mxCell><mxCell id="env" value="Response envelope&lt;br&gt;{success, conversation_id, response{type, markdown, product_tray, suggested_prompts}}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1600" y="410" width="160" height="80" as="geometry"/></mxCell><mxCell id="store" value="conversation_store.py&lt;br&gt;load / save, TTL ~15 min, last 6 msgs&lt;br&gt;failure never blocks an answer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="560" width="190" height="70" as="geometry"/></mxCell><mxCell id="llmmod" value="llm/ module (Mistral)&lt;br&gt;chat: mistral-small-latest&lt;br&gt;embed: mistral-embed (1024-d)&lt;br&gt;retry/backoff + prompts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="560" width="200" height="80" as="geometry"/></mxCell><mxCell id="ret" value="retrieval/search.py&lt;br&gt;cosine distance, source_type filter, top-k" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="560" width="190" height="60" as="geometry"/></mxCell><mxCell id="repo" value="db/repositories/*&lt;br&gt;SQL only. products = source of truth for price, stock, URL, image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1370" y="560" width="220" height="70" as="geometry"/></mxCell><mxCell id="pg" value="Neon Postgres + pgvector&lt;br&gt;products | embeddings | conversations" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;boundedLbl=1;size=10;" vertex="1" parent="1"><mxGeometry x="1260" y="700" width="230" height="90" as="geometry"/></mxCell><mxCell id="chg" value="What changed vs the original design&lt;br&gt;&lt;br&gt;1. Validator can loop back to composer ONCE, then fallback (new node).&lt;br&gt;2. Composer skips validator for empty/error specialist results (fixed reply).&lt;br&gt;3. finalize node saves state before the envelope.&lt;br&gt;4. Clarification is resumable: next message answering it merges with the original query and skips sufficiency (never asks twice).&lt;br&gt;5. State persisted in Postgres with ~15 min expiry.&lt;br&gt;6. Error envelope {success:false, error} for failures/timeouts.&lt;br&gt;7. One specialist per intent (docs mention multi-specialist; not implemented)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="540" height="270" as="geometry"/></mxCell><mxCell id="leg" value="Legend&lt;br&gt;&lt;br&gt;Orange = LLM call (Mistral)&lt;br&gt;Blue = deterministic Python&lt;br&gt;Green = state / data store&lt;br&gt;Red = fallback&lt;br&gt;Purple = entry / final response&lt;br&gt;Dashed grey = state read/write or data access" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="300" height="140" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="svc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="svc" target="sl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sl" target="qu"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="in_scope" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block