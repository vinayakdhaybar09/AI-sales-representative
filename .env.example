APP_ENV=development
LOG_LEVEL=INFO

MISTRAL_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
DATABASE_URL=

CHAT_MODEL=mistral-small-latest
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIMENSIONS=1024

CONVERSATION_TTL_MINUTES=15
REQUEST_TIMEOUT_SECONDS=90
REVIEWER_ENABLED=true
REVIEWER_TIMEOUT_SECONDS=15
CONVERSATION_TIMEOUT_SECONDS=15
COMPOSER_TEMPERATURE=0.3

# Salesperson agent (models are tried in order; Mistral CHAT_MODEL is the last resort)
AGENT_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
AGENT_MAX_ROUNDS=4
AGENT_HISTORY_MESSAGES=10
SESSION_TTL_MINUTES=360
